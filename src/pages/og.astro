---
// Fuente de public/og.jpg, la imagen al compartir el enlace. Para regenerarla: npm run flyer
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/instrument-serif/400-italic.css';
import { Image } from 'astro:assets';
import Logo from '../assets/marca/logo.svg';
import foto from '../assets/flyer-portada.jpg';
import { sitio } from '../data/sitio';
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Imagen para compartir</title>
  </head>
  <body>
    <main>
      <Image src={foto} alt="" width={960} quality={88} />
      <div>
        <Logo class="logo" />
        <h1>Tu estilo, <em>nuestra</em> pasión.</h1>
        <p>Barbería en {sitio.ciudad}</p>
      </div>
    </main>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #0b0b0b; }

  main {
    position: relative;
    display: grid;
    place-items: center;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    color: #f4f2ee;
    font-family: 'Archivo Variable', Arial, sans-serif;
    text-align: center;
  }

  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
    filter: brightness(0.4);
  }

  main > div { position: relative; display: grid; justify-items: center; gap: 26px; width: 620px; }
  .logo { width: 210px; height: auto; color: #fff; }

  h1 {
    font-size: 56px;
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  em {
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-stretch: 100%;
    letter-spacing: 0;
    text-transform: none;
  }

  p { font-size: 20px; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; }
</style>
