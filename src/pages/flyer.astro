---
// Fuente del PDF descargable. Para regenerarlo: npm run flyer
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/instrument-serif/400-italic.css';
import { Image } from 'astro:assets';
import QRCode from 'qrcode';
import Logo from '../assets/marca/logo.svg';
import foto from '../assets/flyer-portada.jpg';
import { servicios, sitio } from '../data/sitio';

const url = Astro.site!.href;
const urlVisible = Astro.site!.host;
const qr = await QRCode.toString(url, { type: 'svg', errorCorrectionLevel: 'M', margin: 0 });
const lista = servicios.map((s) => ({ ...s, precio: s.precio ?? 'Consultar' }));
const direccion = `${sitio.direccion}, ${sitio.piso}, ${sitio.ciudad}`;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Flyer {sitio.nombre}</title>
  </head>
  <body>
    <section class="hoja afiche">
      <div class="portada">
        <Image src={foto} alt="" width={960} quality={88} format="jpg" />
        <Logo class="logo" />
      </div>

      <h1>Tu estilo, <em>nuestra</em> pasión.</h1>

      <div class="centro">
        <ul class="precios">
          {lista.map((s) => (
            <li><span>{s.nombre}</span><b>{s.precio}</b></li>
          ))}
        </ul>
        <div class="escanea">
          <div class="qr" set:html={qr} />
          <p>Escanea y mira nuestros trabajos</p>
        </div>
      </div>

      <dl class="datos">
        <div><dt>Dirección</dt><dd>{direccion}</dd></div>
        <div><dt>Horario</dt><dd>{sitio.horario}</dd></div>
        <div><dt>Reservas</dt><dd>WhatsApp {sitio.telefonoVisible}</dd></div>
        <div><dt>Instagram</dt><dd>@{sitio.instagram}</dd></div>
      </dl>
    </section>

    <section class="hoja volantes">
      {[0, 1, 2, 3].map(() => (
        <article class="volante">
          <Logo class="logo" />
          <p class="lema">Tu estilo, <em>nuestra</em> pasión.</p>
          <ul class="precios">
            {lista.map((s) => (
              <li><span>{s.nombre}</span><b>{s.precio}</b></li>
            ))}
          </ul>
          <div class="pie">
            <div class="qr" set:html={qr} />
            <p>
              {direccion}<br />
              {sitio.horario}<br />
              WhatsApp {sitio.telefonoVisible}<br />
              {urlVisible}
            </p>
          </div>
        </article>
      ))}
    </section>
  </body>
</html>

<style is:global>
  @page { size: A4; margin: 0; }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { font-family: 'Archivo Variable', Arial, sans-serif; background: #777; }
  ul { list-style: none; }

  .hoja {
    position: relative;
    width: 210mm;
    height: 297mm;
    overflow: hidden;
    break-after: page;
  }

  .hoja:last-child { break-after: auto; }
  .qr svg { display: block; width: 100%; height: auto; }

  h1, .lema { font-weight: 800; font-stretch: 125%; text-transform: uppercase; letter-spacing: -0.02em; line-height: 0.98; }
  em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; font-stretch: 100%; letter-spacing: 0; text-transform: none; }

  .afiche { display: flex; flex-direction: column; background: #0b0b0b; color: #f4f2ee; }
  .portada { position: relative; height: 158mm; overflow: hidden; }
  .portada img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 28%; }
  .portada .logo { position: absolute; top: 11mm; left: 13mm; width: 44mm; height: auto; color: #fff; }
  .portada::after { content: ''; position: absolute; inset: 0 0 auto; height: 50mm; background: linear-gradient(rgb(11 11 11 / 0.72), transparent); }
  .portada .logo { z-index: 1; }

  h1 { padding: 7mm 13mm 6mm; font-size: 14.5mm; }

  .centro { display: grid; grid-template-columns: minmax(0, 1fr) 46mm; gap: 12mm; padding-inline: 13mm; align-items: start; }

  .precios li { display: flex; justify-content: space-between; gap: 4mm; border-bottom: 0.2mm solid currentColor; }
  .afiche .precios li { padding-block: 1.3mm; font-size: 3.8mm; border-color: rgb(244 242 238 / 0.28); }
  .precios span { font-weight: 700; font-stretch: 112%; text-transform: uppercase; }
  .precios b { font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }

  .escanea .qr { padding: 3.5mm; background: #fff; }
  .escanea p { margin-top: 2.5mm; font-size: 3mm; text-align: center; }

  .datos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2mm 12mm;
    margin-top: auto;
    padding: 4.5mm 13mm 7mm;
    border-top: 0.2mm solid rgb(244 242 238 / 0.28);
    font-size: 3.3mm;
  }

  dt { margin-bottom: 0.6mm; font-size: 2.4mm; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #a5a29c; }

  .volantes { display: grid; grid-template: repeat(2, 1fr) / repeat(2, 1fr); background: #fff; color: #0b0b0b; }

  .volante { display: flex; flex-direction: column; padding: 8mm; border: 0.15mm dashed #aaa; }
  .volante .logo { width: 28mm; height: auto; }
  .lema { margin-block: 6mm 5mm; font-size: 8mm; }
  .volante .precios li { padding-block: 1.45mm; font-size: 3.2mm; border-color: #cfccc6; }
  .volante .pie { display: grid; grid-template-columns: 34mm minmax(0, 1fr); gap: 4mm; align-items: center; margin-top: auto; }
  .volante .pie p { font-size: 2.55mm; line-height: 1.42; }
</style>
