---
import { Image } from 'astro:assets';
import foto from '../assets/estudio/salon-trabajo.jpg';
import { sitio } from '../data/sitio';
---

<section class="reserva">
  <Image class="fondo" src={foto} alt="" widths={[960]} sizes="100vw" />
  <div class="contenido" data-entrada>
    <h2 class="titular">¿Listo para tu <em>cambio</em> de look?</h2>
    <a class="boton boton--lleno" href={sitio.urlWhatsapp} target="_blank" rel="noopener">Reservar: {sitio.telefonoVisible}</a>
  </div>
</section>

<style>
  .reserva {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 80svh;
    padding: 5rem var(--margen);
    overflow: hidden;
    text-align: center;
  }

  .fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
    filter: grayscale(1) brightness(0.34);
  }

  .contenido { position: relative; display: grid; gap: 2rem; justify-items: center; }
</style>
