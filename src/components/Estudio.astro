---
import { Image } from 'astro:assets';
import dueno from '../assets/estudio/dueno.jpg';
import salon from '../assets/estudio/salon-panoramica.jpg';
import { sitio } from '../data/sitio';
---

<section class="seccion estudio" id="estudio">
  <div class="cabeza" data-entrada>
    <p class="etiqueta">El estudio</p>
    <h2 class="titular">Hecho <em>a</em> mano, a tu medida.</h2>
  </div>

  <div class="cuerpo">
    <figure class="retrato" data-entrada>
      <Image src={dueno} alt={`Retrato de ${sitio.dueno.nombre}, dueño de WB Hair Studio`} widths={[430, 860]} sizes="(max-width: 760px) 100vw, 34vw" />
      <figcaption>
        {sitio.dueno.nombre ?? <span class="pendiente">Nombre por confirmar</span>}
        <span class="etiqueta">{sitio.dueno.cargo}</span>
      </figcaption>
    </figure>

    <div class="relato" data-entrada>
      <p class="intro">
        Cortes clásicos y modernos, degradados, barba y diseños, en un segundo piso con
        luz natural sobre {sitio.direccion.replace('Av. ', 'la avenida ')}, en {sitio.ciudad}.
      </p>
      <p class="pendiente">Aquí va la historia del estudio: cómo partió, desde cuándo y qué lo hace distinto.</p>
      <Image class="escena" src={salon} alt="Vista general del salón, con techo de madera y sillones de barbero" widths={[640, 1280]} sizes="(max-width: 760px) 100vw, 45vw" />
    </div>
  </div>
</section>

<style>
  .estudio { display: grid; gap: clamp(3rem, 7vw, 6rem); }
  .cabeza { display: grid; gap: 1.5rem; }

  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 5fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .retrato img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--linea);
    margin-top: 0.75rem;
  }

  figcaption .etiqueta { color: var(--gris); align-self: center; }

  .relato { display: grid; gap: 2rem; padding-top: clamp(0rem, 6vw, 5rem); }
  .intro { font-family: var(--serif); font-style: italic; font-size: clamp(1.75rem, 3.2vw, 2.75rem); line-height: 1.15; }
  .escena { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; object-position: 50% 60%; }

  @media (max-width: 760px) {
    .cuerpo { grid-template-columns: minmax(0, 1fr); }
  }
</style>
