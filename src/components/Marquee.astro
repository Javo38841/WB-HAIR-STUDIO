---
import { servicios } from '../data/sitio';

const nombres = servicios.map((s) => s.nombre);
const tira = [...nombres, ...nombres];
---

<div class="marquee" aria-hidden="true">
  {[0, 1].map(() => (
    <ul>
      {tira.map((nombre) => (
        <li>{nombre}<span>✦</span></li>
      ))}
    </ul>
  ))}
</div>

<style>
  .marquee {
    display: flex;
    overflow: hidden;
    background: var(--blanco);
    color: var(--negro);
    padding-block: 0.9rem;
  }

  ul {
    display: flex;
    flex: none;
    animation: correr 32s linear infinite;
  }

  li {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    padding-right: 1.75rem;
    font-size: 1.05rem;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  span { font-size: 0.7em; }

  @keyframes correr {
    to { transform: translateX(-100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    ul { animation: none; }
  }
</style>
