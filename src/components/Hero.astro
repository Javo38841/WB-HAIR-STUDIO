---
import { Image } from 'astro:assets';
import foto from '../assets/portada.jpg';
import { sitio } from '../data/sitio';
---

<section class="hero" id="inicio">
  <Image
    class="foto"
    src={foto}
    alt="Cliente de perfil con un degradado bajo y el pelo peinado hacia un lado"
    widths={[640, 960]}
    sizes="(max-width: 760px) 100vw, 46vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="texto">
    <p class="etiqueta">Barbería en {sitio.ciudad}</p>
    <h1 class="titular">Tu estilo, <em>nuestra</em><br />pasión.</h1>
    <div class="acciones">
      <a class="boton boton--lleno" href={sitio.urlWhatsapp} target="_blank" rel="noopener">Reservar por WhatsApp</a>
      <a class="boton" href="#trabajos">Ver trabajos</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    padding: 6rem var(--margen) 2.5rem;
    align-items: end;
    overflow: hidden;
  }

  .foto {
    position: absolute;
    top: 0;
    right: 0;
    width: 46%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    filter: grayscale(1) contrast(1.05);
    animation: acercar 1.6s var(--curva) both;
  }

  .texto { position: relative; display: grid; gap: 1.75rem; }

  .titular {
    max-width: 11ch;
    font-size: clamp(2.6rem, 7vw, 8.5rem);
  }

  .acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  @keyframes acercar {
    from { transform: scale(1.06); opacity: 0; }
  }

  @media (max-width: 760px) {
    .hero { padding-top: 5rem; align-items: end; }
    .foto { width: 100%; height: 66%; object-position: 50% 30%; }
    .foto { mask-image: linear-gradient(#000 70%, transparent); }
    .titular { font-size: 12.2vw; }
    .acciones .boton { flex: 1 1 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .foto { animation: none; }
  }
</style>
