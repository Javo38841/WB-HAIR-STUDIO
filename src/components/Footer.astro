---
import Logo from '../assets/marca/logo.svg';
import { navegacion, sitio } from '../data/sitio';
---

<footer class="pie">
  <Logo class="logo" role="img" aria-label={sitio.nombre} />
  <nav aria-label="Pie de página">
    <ul>
      {navegacion.map((item) => (
        <li><a href={item.href}>{item.texto}</a></li>
      ))}
      <li><a href={sitio.urlInstagram} target="_blank" rel="noopener">Instagram</a></li>
    </ul>
  </nav>
  <div class="base">
    <p class="etiqueta">© {new Date().getFullYear()} {sitio.nombre}</p>
    <p class="credito">
      ¿Quieres una web así?{' '}
      <a href={sitio.credito.url} target="_blank" rel="noopener">Hecha por {sitio.credito.autor} ↗</a>
    </p>
  </div>
</footer>

<style>
  .pie {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2.5rem;
    align-items: end;
    padding: clamp(3rem, 7vw, 5rem) var(--margen) 2rem;
  }

  .logo { width: clamp(9rem, 20vw, 14rem); height: auto; }
  ul { display: flex; flex-wrap: wrap; justify-content: end; gap: 0.5rem 1.75rem; font-size: 0.9375rem; }

  .base {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--linea);
    color: var(--gris);
  }

  .credito { font-size: 0.875rem; }
  .credito a {
    display: inline-block;
    padding-block: 0.35rem;
    color: var(--blanco);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  @media (max-width: 760px) {
    .pie { grid-template-columns: minmax(0, 1fr); }
    ul { justify-content: start; }
  }
</style>
